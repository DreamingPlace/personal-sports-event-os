<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Frozen Python loads embedded ad-hoc dylibs, which have no Team ID.
       Keep hardened runtime; permit this one required library-loading exception.
       Tauri applies this file to the app and its external binaries. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
